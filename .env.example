# ==============================================================================
# BRB Server - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your local environment:
#   cp .env.example .env (Git Bash / Linux / macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Put your REAL credentials in .env only. Never commit .env, and never paste a
# live database URL into this file, a PR, or an issue.
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-brb-dev-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Production/team database is Render-managed PostgreSQL (Singapore region).
# Get the real connection string from the Render dashboard and put it in .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
# Run the dev server against a throwaway local SQLite instead (uncomment):
# DATABASE_URL=sqlite:///db.sqlite3
#
# Running the test suite against a shared Postgres means the test runner creates
# and drops a whole `test_<name>` database on that server every run, and needs
# CREATEDB rights. To keep tests fast and off shared infrastructure, override the
# URL for the test command only (a real env var beats .env):
#   PowerShell:  $env:DATABASE_URL="sqlite:///db.sqlite3"; uv run python manage.py test
#   bash:        DATABASE_URL=sqlite:///db.sqlite3 uv run python manage.py test

# Authentication & Security
# Secret for signing and verifying JWT tokens.
# Must be at least 32 bytes: HS256 (the algorithm configured in
# brb_server/settings.py SIMPLE_JWT) rejects shorter keys at runtime.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-this-with-secrets-token-urlsafe-48-output-min-32-bytes

# Identity Document Encryption at Rest (CP-107, FR3, NFR 4.2)
# Fernet symmetric encryption key for raw identity document bytes in Postgres.
# Must be 32 url-safe base64-encoded bytes. Unset in dev/test passes through plaintext;
# in production (DEBUG=False, Postgres) an unset key fails closed.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IDENTITY_DOCUMENT_ENCRYPTION_KEY=

# PUP Community Webmail Validation (SRS Section 4.2)
ALLOWED_STUDENT_EMAIL_DOMAIN=iskolarngbayan.pup.edu.ph
ALLOWED_FACULTY_EMAIL_DOMAIN=pup.edu.ph

# Scheduled Background Jobs Security (SRS Section 2.4 & 5.2)
# Secret bearer token used by cron-job.org to trigger scheduled jobs:
#   POST /api/v1/jobs/deactivate-unverified/  (CP-102, purges unconfirmed accounts)
#   POST /api/v1/jobs/check-overdue/          (CP-506)
# Unset means the endpoint refuses to run at all (503) rather than running open.
CRON_SECRET_TOKEN=local-dev-cron-token-brb

# Email Configuration
# Uses console backend locally to print email verification & reset links to terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@brb.pup.edu.ph

# Where the CP-102 confirmation link points. The token is appended as a query
# string (?uid=...&token=...), so the frontend receives it and can call
# POST /api/v1/auth/verify-email/ with those two values.
EMAIL_VERIFICATION_REDIRECT_URL=brb://auth/verify-email

# Production/Staging Email Provider (Resend / SendGrid)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=your_resend_api_key
# EMAIL_USE_TLS=True

# File Storage
# CP-105 identity documents are NOT stored in an external bucket or on disk:
# the bytes are written into Postgres (identity_documents.document_data). Render's
# filesystem is ephemeral and its free tier has no persistent disk, so a file on
# disk would be lost on the next redeploy. See DECISIONS.md D-13.
#
# The default storage backend below therefore only serves cosmetic fields such as
# users.photo. No Cloudinary (or other object-store) credentials are needed, and
# the cloudinary / django-cloudinary-storage packages are no longer dependencies.
MEDIA_ROOT=media
MEDIA_URL=media/
