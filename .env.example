# ==============================================================================
# BRB Server - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your local environment:
#   cp .env.example .env (Git Bash / Linux / macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# DO NOT commit your .env file to version control.
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-brb-dev-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Default: SQLite for fast zero-config local development
# DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL parity with production (Render):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brb_db
DATABASE_PASSWORD=yourpassword

# Authentication & Security
# Secret for signing and verifying JWT tokens.
# Must be at least 32 bytes: HS256 (the algorithm configured in
# brb_server/settings.py SIMPLE_JWT) rejects shorter keys at runtime.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-this-with-secrets-token-urlsafe-48-output-min-32-bytes

# PUP Community Webmail Validation (SRS Section 4.2)
ALLOWED_STUDENT_EMAIL_DOMAIN=iskolarngbayan.pup.edu.ph
ALLOWED_FACULTY_EMAIL_DOMAIN=pup.edu.ph

# Scheduled Background Jobs Security (SRS Section 2.4 & 5.2)
# Secret bearer token used by cron-job.org to trigger overdue/unreturned status checks
CRON_SECRET_TOKEN=local-dev-cron-token-brb

# Email Configuration
# Uses console backend locally to print email verification & reset links to terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@brb.pup.edu.ph

# Production/Staging Email Provider (Resend / SendGrid)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=your_resend_api_key
# EMAIL_USE_TLS=True

# CLOUDINARY FOR STORAGE
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
